{
  "name": "murdoku-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test:browser": "node tests/browser/visual.mjs",
    "test:proxy": "node tests/browser/proxy.mjs",
    "render": "node scripts/render_visual.mjs",
    "test:engine": "node --test 'tests/engine/*.test.mjs'",
    "export:cases": ".venv/bin/python -m murdoku_lab.visual.play_export",
    "test:play": "node tests/browser/play.mjs",
